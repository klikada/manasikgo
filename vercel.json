{
  "redirects": [
    {
      "source": "/detail.html",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>.*)" }],
      "destination": "/artikel/:slug",
      "permanent": true
    },
    {
      "source": "/istilah-detail.html",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>.*)" }],
      "destination": "/istilah/:slug",
      "permanent": true
    },
    {
      "source": "/detail-pengalaman.html",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.*)" }],
      "destination": "/cerita/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/artikel/:slug", "destination": "/detail.html?slug=:slug" },
    { "source": "/istilah/:slug", "destination": "/istilah-detail.html?slug=:slug" },
    { "source": "/cerita/:id", "destination": "/detail-pengalaman.html?id=:id" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
